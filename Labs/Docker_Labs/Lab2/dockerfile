# Stage 1: Build and Train the Model
FROM python:3.10-slim AS model_training

WORKDIR /app

COPY src/model_training.py /app/
COPY requirements.txt /app/

RUN pip install --no-cache-dir -r requirements.txt
RUN python model_training.py


# Stage 2: Serve Predictions
FROM python:3.10-slim AS serving

WORKDIR /app

COPY --from=model_training /app/my_model.keras /app/
COPY --from=model_training /app/scaler.pkl /app/
COPY --from=model_training /app/knn_model.pkl /app/
COPY src/main.py /app/
COPY requirements.txt /app/

RUN pip install --no-cache-dir --trusted-host pypi.python.org -r requirements.txt

COPY src/templates /app/templates
COPY src/statics /app/statics

RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

CMD ["python", "main.py"]
